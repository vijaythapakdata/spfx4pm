{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "training-web-part-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/trainingWebPart/TrainingWebPartWebPart.js",
          "manifest": "./src/webparts/trainingWebPart/TrainingWebPartWebPart.manifest.json"
        }
      ]
    },
    "functional-form-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/functionalForm/FunctionalFormWebPart.js",
          "manifest": "./src/webparts/functionalForm/FunctionalFormWebPart.manifest.json"
        }
      ]
    },
    "formik-validation-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/formikValidation/FormikValidationWebPart.js",
          "manifest": "./src/webparts/formikValidation/FormikValidationWebPart.manifest.json"
        }
      ]
    },
    "paginated-items-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/paginatedItems/PaginatedItemsWebPart.js",
          "manifest": "./src/webparts/paginatedItems/PaginatedItemsWebPart.manifest.json"
        }
      ]
    },
    "large-list-code-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/largeListCode/LargeListCodeWebPart.js",
          "manifest": "./src/webparts/largeListCode/LargeListCodeWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "TrainingWebPartWebPartStrings": "lib/webparts/trainingWebPart/loc/{locale}.js",
    "FunctionalFormWebPartStrings": "lib/webparts/functionalForm/loc/{locale}.js",
    "ControlStrings": "node_modules/@pnp/spfx-controls-react/lib/loc/{locale}.js",
    "FormikValidationWebPartStrings": "lib/webparts/formikValidation/loc/{locale}.js",
    "PaginatedItemsWebPartStrings": "lib/webparts/paginatedItems/loc/{locale}.js",
    "LargeListCodeWebPartStrings": "lib/webparts/largeListCode/loc/{locale}.js"
  }
}
